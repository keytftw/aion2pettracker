<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\src\PetTracker.App\UiText.cs" Link="SharedText\UiText.cs" />
    <Compile Include="..\..\src\PetTracker.App\StartupText.cs" Link="SharedText\StartupText.cs" />
    <Compile Include="..\..\src\PetTracker.App\TermsContent.cs" Link="SharedText\TermsContent.cs" />
    <Compile Include="..\..\src\PetTracker.Setup\InstallerText.cs" Link="SharedText\InstallerText.cs" />
    <Compile Include="..\..\src\PetTracker.App\MapText.cs" Link="SharedText\MapText.cs" />
    <Content Include="..\..\data\pet-catalog.json" Link="data\pet-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\pet-sources.json" Link="data\pet-sources.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\maps\spawns.json" Link="data\maps\spawns.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PetTracker.Core\PetTracker.Core.csproj" />
    <ProjectReference Include="..\..\src\PetTracker.Capture\PetTracker.Capture.csproj" />
  </ItemGroup>

</Project>
