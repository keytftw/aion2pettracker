<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>1.0.0</Version>
    <AssemblyName>A2PetTracker-win-Setup</AssemblyName><Product>Aion 2 Pet Tracker Setup</Product>
    <DefineConstants>$(DefineConstants);SETUP_UI;UI_FONTS</DefineConstants>
    <ApplicationIcon>..\PetTracker.App\Assets\App.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\PetTracker.App\Assets\Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\licenses\*-OFL.txt" LogicalName="FontLicenses.%(Filename)%(Extension)" />
    <Compile Include="..\PetTracker.App\FontAssets.cs" Link="Shared\FontAssets.cs" />
    <ProjectReference Include="..\PetTracker.Core\PetTracker.Core.csproj" />
    <Compile Include="..\PetTracker.App\PremiumControls.cs" Link="Shared\PremiumControls.cs" />
    <Compile Include="..\PetTracker.App\AnimationClock.cs" Link="Shared\AnimationClock.cs" />
    <Compile Include="..\PetTracker.App\AppBrand.cs" Link="Shared\AppBrand.cs" />
    <Compile Include="..\PetTracker.App\CrystalCursor.cs" Link="Shared\CrystalCursor.cs" />
    <Compile Include="..\PetTracker.App\UiText.cs" Link="Shared\UiText.cs" />
    <Compile Include="..\PetTracker.App\StartupText.cs" Link="Shared\StartupText.cs" />
    <Compile Include="..\PetTracker.App\TermsContent.cs" Link="Shared\TermsContent.cs" />
    <Compile Include="..\PetTracker.App\TermsView.cs" Link="Shared\TermsView.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(InstallerPayload)' != ''">
    <EmbeddedResource Include="$(InstallerPayload)" LogicalName="InstallPayload" />
    <EmbeddedResource Include="$(InstallerPayloadHash)" LogicalName="InstallPayloadHash" />
  </ItemGroup>
  <Target Name="RequireInstallerPayload" BeforeTargets="Publish">
    <Error Condition="!Exists('$(InstallerPayload)') or !Exists('$(InstallerPayloadHash)')" Text="Publish Setup with the matching Velopack Setup payload and SHA256 metadata. Use tools/Build-Setup.ps1." />
  </Target>
</Project>
