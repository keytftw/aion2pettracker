<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PetTracker.Core\PetTracker.Core.csproj" />
    <Content Include="..\..\data\servers.json" Link="data\servers.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\pet-catalog.json" Link="data\pet-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\pets\*.png" Link="data\pets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\PET-SOURCES.md" Link="data\PET-SOURCES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\*" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetTracker.Capture\PetTracker.Capture.csproj" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.7.0</Version>
    <AssemblyTitle>Aion 2 Pet Tracker</AssemblyTitle>
    <AssemblyName>A2PetTracker</AssemblyName>
    <Product>Aion 2 Pet Tracker</Product>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
